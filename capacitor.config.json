{
  "appId": "com.globalcollege.sms",
  "appName": "Global College",
  "webDir": "dist",
  "bundledWebRuntime": false,
  "server": {
    "url": "https://cloud.eclat.institute",
    "cleartext": true,
    "androidScheme": "https",
    "allowNavigation": [
      "cloud.eclat.institute",
      "*.eclat.institute"
    ]
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "ios": {
    "contentInset": "always"
  }
}
