{
  "name": "global-college-sms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173",
    "build": "tsc -b && vite build",
    "test": "node tests/unit_tests.js",
    "lint": "oxlint",
    "preview": "vite preview",
    "desktop": "electron .",
    "desktop:build": "npm run build && electron .",
    "desktop:dist": "npm run build && electron-builder --win",
    "desktop:store": "npm run build && electron-builder --win appx",
    "cap:sync": "npm run build && npx cap sync",
    "android:sync": "npm run build && npx cap sync android",
    "android:build": "npm run build && npx cap sync android && cd android && gradlew.bat assembleDebug",
    "android:open": "npm run build && npx cap open android",
    "ios:open": "npm run build && npx cap open ios"
  },
  "build": {
    "appId": "com.globalcollege.sms",
    "productName": "Global College SMS",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "public/**/*"
    ],
    "win": {
      "icon": "public/icon.ico",
      "target": [
        "appx",
        "nsis",
        "portable"
      ]
    },
    "appx": {
      "identityName": "GlobalCollege.SchoolManagementSystem",
      "publisher": "CN=E227A441-60A1-4818-8C91-AA5CDA56D0DE",
      "publisherDisplayName": "Global College",
      "displayName": "Global College SMS",
      "applicationId": "GlobalCollege.SchoolManagementSystem",
      "backgroundColor": "#f8fafc"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Global College SMS"
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.5.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/camera": "^8.2.6",
    "@capacitor/core": "^8.5.1",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/status-bar": "^8.0.4",
    "@hookform/resolvers": "^5.4.0",
    "@supabase/supabase-js": "^2.110.0",
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.81.0",
    "react-player": "^3.4.0",
    "react-router-dom": "^7.18.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.0.2",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@electron/get": "^5.1.0",
    "global-agent": "^4.1.3",
    "roarr": "^7.21.7"
  }
}
